#!/bin/bash
set -e

# Collect all arguments to pass to xh
ARGS=("$@")

# Detect OS and run appropriate command
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS terminal variant - launch xh in a new Terminal window from current directory
    osascript -e 'tell application "Terminal" to activate' -e "tell application \"Terminal\" to do script \"cd \\\"$PWD\\\" && xh ${ARGS[*]@Q}\""
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux/gnome terminal variant - invoke xh in a new terminal
    gnome-terminal -- bash -c "exec xh ${ARGS[*]@Q}"
else
    echo "Unsupported OS: $OSTYPE" >&2
    exit 1
fi
