#!/bin/bash
set -e

# Detect OS and run appropriate command
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS terminal variant - launch sclaude in a new Terminal window from current directory
    osascript -e 'tell application "Terminal" to activate' -e "tell application "Terminal" to do script "cd \\"$PWD\\" && ~/sclaude""
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux/gnome terminal variant - invoke sclaude in a new terminal
    gnome-terminal -- bash -c "exec ~/sclaude"
else
    echo "Unsupported OS: $OSTYPE" >&2
    exit 1
fi
